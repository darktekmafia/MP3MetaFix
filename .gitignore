# =====================================================================
# MP3MetaFix .gitignore - Public Repository Hardening
# =====================================================================

# ---------------------------------------------------------------------
# 1. Python Bytecode & Compilation Artifacts
# ---------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
*.pyd
*.dll
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# ---------------------------------------------------------------------
# 2. Virtual Environments
# ---------------------------------------------------------------------
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# ---------------------------------------------------------------------
# 3. Secrets, Keys & Environment Variables
# ---------------------------------------------------------------------
.env
.env.*
!.env.example
*.key
*.secret
*.pem
*.crt
*.p12
*.pfx
.secret_key
data/.secret_key

# ---------------------------------------------------------------------
# 4. Runtime Storage, Sessions & User Uploads
# ---------------------------------------------------------------------
data/
temp/
tmp/
*.sqlite
*.sqlite3
*.db
*.db-wal
*.db-shm

# ---------------------------------------------------------------------
# 5. Audio, Video & Image Test Uploads (Root/Scratch)
# ---------------------------------------------------------------------
*.mp3
*.wav
*.flac
*.m4a
!tests/fixtures/tone.m4a
*.ogg
*.opus
*.aac
*.wma
*.aiff
*.lrc

# ---------------------------------------------------------------------
# 6. Testing, Quality & Coverage
# ---------------------------------------------------------------------
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.mypy_cache/
.ruff_cache/

# ---------------------------------------------------------------------
# 7. Logs & Process Artifacts
# ---------------------------------------------------------------------
logs/
*.log
*.pid
nohup.out

# ---------------------------------------------------------------------
# 8. OS & Desktop Artifacts
# ---------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ---------------------------------------------------------------------
# 9. IDEs & Text Editors
# ---------------------------------------------------------------------
.idea/
.vscode/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~
*.bak

# ---------------------------------------------------------------------
# 10. Archives & Compressed Packages
# ---------------------------------------------------------------------
*.zip
*.tar
*.tar.gz
*.tgz
*.rar
*.7z
*.bz2
*.xz

# ---------------------------------------------------------------------
# 11. Local Agent Customizations, Internal Planning & Work Logs
# ---------------------------------------------------------------------
.agents/
AGENTS.md
GEMINI.md
SESSION_HANDOFF*.md
session_handoff*.md
# Keep only the short public documentation notice
!SESSION_HANDOFF_2026-09-20.md
.cursor/
.windsurf/
scratch/
*.scratch.*

# Retained local account-migration recovery data
/data.migration-restore/
/data.before-account-rollback*/

# Local internal developer documentation, planning, gap analyses & work logs (never public)
internal/
/internal/
/INTERNAL_ROADMAP.md
/CODEBASE_GAP_ANALYSIS.md
*GAP_ANALYSIS*.md
*gap_analysis*.md
*INVESTIGATION*.md
*investigation*.md
DEMO_*

# ---------------------------------------------------------------------
# 12. Patch & Merge Backups
# ---------------------------------------------------------------------
*.orig
*.rej
*.patch

!tests/fixtures/opus.m4a

